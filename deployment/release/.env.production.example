# ============================================================
# Cấu hình môi trường cho Docker Compose (release-docker-compose.yaml)
# File này được lưu tại /home/ubuntu/ecommerce/deployment/release/.env
# ============================================================

# Docker Hub Registry & Image Tag
REGISTRY=corncorn0505
VERSION=release-v0.0.0-initial

# PostgreSQL Database Credentials
POSTGRES_DB=ecommerce
POSTGRES_USER=app_user
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_RANDOM_PASSWORD
