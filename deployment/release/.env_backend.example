# ============================================================
# Cấu hình môi trường cho Backend NestJS Container
# File này được lưu tại /home/ubuntu/ecommerce/deployment/release/.env_backend
# ============================================================

# Database Connection (hostname là postgres_service trong docker network)
DATABASE_URL=postgresql://app_user:URL_ENCODED_PASSWORD@postgres_service:5432/ecommerce?schema=public

# Redis Connection (hostname là redis_service trong docker network)
REDIS_HOST=redis_service
REDIS_PORT=6379

# Server Runtime
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=http://YOUR_EC2_PUBLIC_IP
CLIENT_URL=http://YOUR_EC2_PUBLIC_IP
SERVER_URL=http://YOUR_EC2_PUBLIC_IP

# JWT Secrets (sinh bằng: openssl rand -hex 32)
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_KEY
JWT_REFRESH_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_KEY

# Cloudinary Integration (upload hình ảnh sản phẩm/avatar)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
REPLICATE_API_TOKEN=

# Mail Service (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="No Reply <noreply@example.com>"

# SePay Payment Gateway
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_ENV=production

# System Timezone
TZ=Asia/Ho_Chi_Minh
