{
  "name": "modern-ecommerce-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "dev:server": "pnpm --filter @ecommerce/server run dev",
    "dev:client": "pnpm --filter @ecommerce/client run dev",
    "build": "pnpm -r run build",
    "build:server": "pnpm --filter @ecommerce/server run build",
    "build:client": "pnpm --filter @ecommerce/client run build",
    "lint": "pnpm -r run lint"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.1",
      "@types/react-dom": "19.0.2"
    }
  }
}
